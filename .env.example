# Copy to .env before running `pnpm dev` or `pnpm build`.
# PUBLIC_SITE_URL is read through `$env/static/public`, so it must be present
# at build time — without it the build fails rather than falling back.

# Site Metadata
PUBLIC_SITE_TITLE="devlog"
PUBLIC_SITE_DESCRIPTION="Changelog and devlog for ewan's projects."
PUBLIC_SITE_URL="https://devlog.croft.click"

# AT Protocol
PUBLIC_ATPROTO_DID="did:plc:ofrbh253gwicbkc5nktqepol"
